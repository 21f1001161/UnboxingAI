GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
SESSION_SECRET=replace-with-a-long-random-string

# Level-adapted explanations (Beginner / Intermediate / Expert).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma-separated fallback chain, first model that answers wins.
GEMINI_MODEL=gemini-flash-latest,gemini-3.7-flash,gemini-2.5-flash

# Multi-source coverage and exploration topics on the In-depth research tab.
# Get one at https://app.tavily.com
TAVILY_API_KEY=

# Source digest. Override to point the timeline at a different weekly digest.
DIGEST_URL=https://elbruno.github.io/weekly-ai-news-digest/
APP_URL=http://localhost:5173

# Optional real email nudges. Create an API key at https://resend.com.
# EMAIL_FROM must be a verified sender, for example: UnboxingAI <hello@example.com>
RESEND_API_KEY=
EMAIL_FROM=
NUDGE_CRON_SECRET=replace-with-a-long-random-string
# Sunday delivery hour in UTC for a single Express deployment.
NUDGE_HOUR_UTC=10
